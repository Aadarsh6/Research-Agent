# ---- LLM: fill in ONE key (checked in this order: Gemini -> Groq -> OpenAI) ----
# Gemini and Groq both have free tiers.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_MODEL=gpt-4o-mini

# ---- Tavily MCP (free tier: 1,000 credits/month, https://tavily.com) ----
# Optional. Without it (or when the free quota runs out) DuckDuckGo is used automatically.
TAVILY_API_KEY=

# ---- Academic sources (all free) ----
# Optional but recommended: your email puts you in the faster "polite pool" of OpenAlex and Crossref.
CONTACT_EMAIL=
# Optional: free key from semanticscholar.org/product/api (without it the API is slow / rate-limited)
SEMANTIC_SCHOLAR_API_KEY=

# ---- Playwright MCP (optional, for JavaScript-heavy websites) ----
ENABLE_PLAYWRIGHT_MCP=false
# Windows default is msedge (already installed). Other systems: chromium, chrome, firefox
# PLAYWRIGHT_MCP_BROWSER=msedge

# ---- Filesystem MCP: the ONLY folder it may read/write (default: <project>/research) ----
# RESEARCH_DIR=
